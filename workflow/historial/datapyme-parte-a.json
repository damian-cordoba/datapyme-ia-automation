    {
      "parameters": {
        "jsCode": "// 02 - Validar y normalizar\n// Valida del lado del servidor, limpia los datos y genera la clave de idempotencia.\nreturn $input.all().map(item => {\n  const d = item.json;\n  const limpiar = v => (v ?? '').toString().trim().replace(/\\s+/g, ' ');\n  const nombre  = limpiar(d['Nombre']);\n  const email   = limpiar(d['Email']).toLowerCase();\n  const empresa = limpiar(d['Empresa']);\n  const mensaje = (d['Mensaje'] ?? '').toString().trim();\n\n  const errores = [];\n  if (nombre.length < 2) errores.push('Nombre vacío o demasiado corto');\n  const emailValido = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(email);\n  if (!email) errores.push('Email vacío');\n  else if (!emailValido) errores.push('Email con formato inválido');\n  if (mensaje.length < 20) errores.push('Mensaje vacío o demasiado corto (mínimo 20 caracteres)');\n  if (mensaje.length > 3000) errores.push('Mensaje demasiado largo (máximo 3000 caracteres)');\n\n  // Huella FNV-1a de email + mensaje: detecta reenvíos idénticos (no es criptográfica).\n  const base = email + '|' + mensaje.toLowerCase().replace(/\\s+/g, ' ');\n  let h = 0x811c9dc5;\n  for (let i = 0; i < base.length; i++) { h ^= base.charCodeAt(i); h = Math.imul(h, 0x01000193) >>> 0; }\n  const clave = 'DD-' + h.toString(16).padStart(8, '0') + '-' + base.length;\n\n  return { json: {\n    nombre, email: emailValido ? email : '', email_recibido: email, empresa, mensaje,\n    fecha_recepcion: new Date().toISOString(),\n    es_valido: errores.length === 0, errores, errores_texto: errores.join('; '),\n    clave_dedup: clave\n  }};\n});\n"
      },
      "id": "7c696dcc-1f35-4ba9-82ef-f664ee7b9368",
